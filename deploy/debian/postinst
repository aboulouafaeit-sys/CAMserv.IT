#!/bin/sh
set -e

# CAMserv post-installation configuration script for Debian 13 (Trixie)
case "$1" in
    configure)
        # 1. Create dedicated system user and group if not present
        if ! getent group camserv >/dev/null; then
            groupadd --system camserv
        fi
        if ! getent passwd camserv >/dev/null; then
            useradd --system --gid camserv --home-dir /opt/camserv \
                --no-create-home --shell /usr/sbin/nologin camserv
        fi

        # 2. Add camserv user to video and render groups for camera and GPU hardware access
        for grp in video render; do
            if getent group "$grp" >/dev/null; then
                usermod -aG "$grp" camserv 2>/dev/null || true
            fi
        done

        # 3. Create persistent standard FHS directories
        mkdir -p /etc/camserv
        mkdir -p /var/log/camserv
        mkdir -p /var/lib/camserv/db
        mkdir -p /var/lib/camserv/recordings
        mkdir -p /var/lib/camserv/vault
        mkdir -p /var/lib/camserv/exports
        mkdir -p /var/lib/camserv/models
        mkdir -p /var/cache/camserv

        # 4. Backward compatibility symlinks for legacy /data architecture
        if [ ! -d /data ]; then
            mkdir -p /data
        fi
        [ ! -e /data/db ] && ln -sf /var/lib/camserv/db /data/db || true
        [ ! -e /data/recordings ] && ln -sf /var/lib/camserv/recordings /data/recordings || true
        [ ! -e /data/vault ] && ln -sf /var/lib/camserv/vault /data/vault || true

        # 5. Set strict least-privilege ownership and permissions
        chown -R camserv:camserv /opt/camserv /etc/camserv /var/log/camserv /var/lib/camserv /var/cache/camserv
        chmod 750 /var/lib/camserv /var/lib/camserv/db /var/lib/camserv/recordings /var/log/camserv
        chmod 700 /var/lib/camserv/vault /etc/camserv

        # 6. Initialize isolated Python virtualenv with PEP 668 compliance
        if [ ! -d /opt/camserv/venv ]; then
            python3 -m venv /opt/camserv/venv --system-site-packages
            chown -R camserv:camserv /opt/camserv/venv
        fi

        # 7. Reload systemd daemon and enable unified target
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable camserv.target || true
        fi
    ;;
esac

exit 0
