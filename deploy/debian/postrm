#!/bin/sh
set -e

case "$1" in
    purge)
        # Preserve recordings and evidence by default under GDPR storage limitation
        # Clean up temporary logs and sockets
        rm -rf /var/log/camserv/*.sock || true
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
        fi
    ;;
esac

exit 0
