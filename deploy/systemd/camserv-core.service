[Unit]
Description=CAMserv Core Orchestrator & Web Console
Documentation=https://github.com/aboulouafaeit-sys/CAMserv.IT
PartOf=camserv.target
After=network.target camserv-storage.service
Requires=camserv-storage.service
Wants=camserv-ingestion.service camserv-inference.service

[Service]
Type=simple
User=camserv
Group=camserv
SupplementaryGroups=video render
WorkingDirectory=/opt/camserv
ExecStart=/opt/camserv/venv/bin/python -m camserv.main serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5
WatchdogSec=15s

# Hardening & Security Sandbox
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateTmp=true
PrivateDevices=false
DevicePolicy=auto
MemoryDenyWriteExecute=false
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/var/lib/camserv/db /var/lib/camserv/vault /var/log/camserv /data/db /data/vault

[Install]
WantedBy=camserv.target
