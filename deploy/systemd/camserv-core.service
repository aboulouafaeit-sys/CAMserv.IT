[Unit]
Description=CAMserv Core Orchestrator & Web Console
Documentation=https://github.com/aboulouafaeit-sys/CAMserv.IT
PartOf=camserv.target
After=network.target camserv-storage.service camserv-ingestion.service camserv-inference.service
Requires=camserv-storage.service

[Service]
Type=notify
User=camserv
Group=camserv
WorkingDirectory=/opt/camserv
ExecStart=/opt/camserv/venv/bin/python -m camserv.main run --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5
WatchdogSec=15s

# Hardening & Security Sandbox
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateTmp=true
PrivateDevices=false
DevicePolicy=auto
MemoryDenyWriteExecute=false
NoNewPrivileges=true
ReadWritePaths=/data/db /data/vault /var/log/camserv

[Install]
WantedBy=camserv.target
